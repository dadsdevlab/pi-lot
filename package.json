{
  "name": "pi-lot",
  "displayName": "Pi-lot",
  "description": "Chat panel in the secondary sidebar.",
  "version": "1.0.2",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/dadsdevlab/pi-lot.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pi-lot.open",
        "title": "Open Pi-lot",
        "icon": "$(comment-discussion)"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "pi-lot",
          "title": "Pi-lot",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "pi-lot": [
        {
          "type": "webview",
          "id": "pi-lot.chat",
          "name": "Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "package": "npm run compile && node -e \"const {execFileSync}=require('child_process'); const v=require('./package.json').version+'-dev.'+Date.now(); execFileSync(process.execPath,['node_modules/@vscode/vsce/vsce','package',v,'--no-update-package-json','--no-git-tag-version','--skip-license'],{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.9.3"
  }
}